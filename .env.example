# ==========================================
# NEUROLAB ENTERPRISE - ENVIRONMENT CONFIG
# ==========================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Authentication
SECRET_KEY=change_this_to_a_super_secret_enterprise_key_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL Database
POSTGRES_USER=neurolab
POSTGRES_PASSWORD=neurolab_secure_pass
POSTGRES_DB=neurolab_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://neurolab:neurolab_secure_pass@postgres:5432/neurolab_db

# Redis Message Broker & Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Object Storage (MinIO / S3 compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=neurolab-artifacts
MINIO_USE_SSL=false

# Worker Resource Limits
MAX_CONCURRENT_TRAININGS=4
TRAINING_TIMEOUT_SECONDS=7200
DEFAULT_DEVICE=cpu

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1
